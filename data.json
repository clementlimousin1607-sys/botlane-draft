  "TIPS": {
    "Caitlyn": "Portée 650 : ne trade pas à portée de ses autos. Évite ses pièges et all-in quand ils sont posés ailleurs.",
    "Jinx": "Aucun dash : punis-la avant ses premiers items et coupe ses resets en combat.",
    "Jhin": "Après sa 4e balle il recharge : c'est ta fenêtre de trade. Sors de la ligne de son W quand tu es marqué.",
    "MissFortune": "Interromps son ult ou sors de la zone. Ne reste pas derrière un sbire bas en vie (rebond du Q).",
    "Kaisa": "Faible avant ses évolutions : punis-la tôt et garde un CC pour la suivre après son ult.",
    "Tristana": "Pic de puissance niveau 2-3 (E + saut) : recule quand la bombe est posée, punis son saut en cooldown.",
    "Yunara": "Hypercarry on-hit : force les trades avant ses items, elle n'aime pas perdre la lane.",
    "Ezreal": "Cache-toi derrière les sbires contre ses Q. Engage quand son E est utilisé.",
    "Ashe": "Son ult peut arriver de très loin : gardez la vision. Aucune mobilité, engagez-la.",
    "Aphelios": "Regarde son arme active et évite les trades contre Infernum/Crescendum. Aucun dash : engagez-le.",
    "Twitch": "Il roam invisible : ward tes buissons, ping ses disparitions. Faible en 1v1 tôt.",
    "Lucian": "Très fort niveau 1-6 : ne trade pas quand son passif est prêt. Il faiblit ensuite.",
    "Samira": "Garde un CC pour interrompre son ult. Son W bloque les projectiles : ne lance rien dedans.",
    "Xayah": "Ne reste pas sur la ligne de ses plumes. Attends son ult avant d'engager.",
    "Draven": "Force-le à bouger pour qu'il rate ses haches. Refuse les trades tôt, il est très fort niveau 1-3.",
    "Smolder": "Faible avant ses stacks : bouscule-le dès le niveau 1 et refuse-lui les sbires.",
    "Vayne": "Éloigne-toi des murs (son E stun). Punis-la avant ses items.",
    "Sivir": "Son bouclier bloque ton meilleur sort : feinte-le avant d'engager.",
    "Zeri": "Très mobile mais fragile tôt : punis-la avant ses items.",
    "Varus": "Reste hors de la ligne de son Q et engage pendant qu'il le charge.",
    "Kalista": "Domine les niveaux 1-2 : refuse les trades, sa puissance baisse ensuite. Attention à son ult.",
    "KogMaw": "Aucune mobilité : engagez-le, il est inoffensif avant 2 items.",
    "Nilah": "Mêlée : garde la distance et punis ses approches sur la vague.",
    "Corki": "Esquive ses Q et engage après son W.",
    "Ziggs": "Il détruit les tours : engage-le, il n'a presque aucune échappatoire.",
    "Veigar": "Évite sa cage (E). Engage quand elle est en cooldown.",
    "Viktor": "Trade court, évite la zone de son W.",
    "Mel": "Son W renvoie les projectiles : attends-le avant de lancer ton skillshot.",
    "Swain": "Il gagne les combats longs : trade court et sors de son ult.",
    "Yasuo": "Son mur de vent bloque les projectiles : attends-le. Ne lui donne pas de knock-up.",
    "Lux": "Esquive sa root en te décalant latéralement. Sans Q, elle est une proie.",
    "Thresh": "Reste derrière tes sbires. Sa lanterne sauve son ADC : coupe-la.",
    "Seraphine": "Reste dispersé pour éviter son stun, engage-la : elle est fragile.",
    "Nautilus": "Ne reste pas au contact (root du passif) et garde tes sbires entre vous.",
    "Leona": "Elle engage au niveau 2 : ne lui laisse pas l'avance de niveau et recule quand E+Q sont prêts.",
    "Morgana": "Son Bouclier noir annule les CC : fais-le sortir avant d'engager. Esquive son Q.",
    "Blitzcrank": "Toujours derrière les sbires. S'il rate son hook, c'est votre fenêtre.",
    "Lulu": "Son polymorph coupe les all-in : force-la à le lancer avant d'engager.",
